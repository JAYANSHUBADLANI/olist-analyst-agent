# Default provider: Groq. Set GROQ_API_KEY and run as is.
GROQ_API_KEY=

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Alternative provider: Vertex AI, serving Gemini through its OpenAI-compatible endpoint.
# Set GCP_PROJECT_ID to switch to this path; it takes priority over the Groq settings above.
# Auth is a short-lived gcloud access token fetched at run time, not a static key here, so
# this needs `gcloud auth login` already done on the machine running it.
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# LLM_MODEL=google/gemini-2.5-flash-lite
